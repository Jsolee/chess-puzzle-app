    "Com menys peces queden, més pesa el material de més. Si vas perdent, conserva-les i complica la partida.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fewer pieces left, the more the extra material counts. When you're behind, keep them and make the game messy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuantas menos piezas quedan, más pesa el material de más. Si vas perdiendo, consérvalas y complica la partida."
