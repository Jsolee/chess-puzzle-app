    "Un bon sacrifici: %@ queda a l'abast, però la valoració es manté.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A good sacrifice: %@ is left in reach, but the evaluation holds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un buen sacrificio: %@ queda al alcance, pero la valoración se mantiene."
