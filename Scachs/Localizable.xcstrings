    "Scachs no està afiliada a chess.com ni a Lichess. Les etiquetes de les jugades les calcula aquesta app amb un model propi i poden no coincidir amb les d'altres serveis.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scachs is not affiliated with chess.com or Lichess. This app works out the move labels with its own model, and they may not match those of other services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Scachs no está afiliada a chess.com ni a Lichess. Las etiquetas de las jugadas las calcula esta app con un modelo propio y pueden no coincidir con las de otros servicios."
          }
        }
      }
    },
